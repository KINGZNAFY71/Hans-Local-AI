# Ollama Server Configuration
# Set to your local Ollama address or your LAN IP (e.g., http://192.168.1.100:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Model to use (must be pulled in Ollama, e.g., 'ollama pull qwen2.5' or 'ollama pull qwen2.5-coder:7b')
OLLAMA_MODEL=qwen2.5-coder:7b

# Directory for markdown notes
NOTES_DIR=./notes
